# Datasets — large, publicly redownloadable via src/data/ scripts
data/raw/
data/interim/
data/processed/
*.npz
*.wav

# Model weights
models/

# Environments
.venv/
tools/node_modules/
__pycache__/
*.pyc

# OS
.DS_Store

# Manuscript drafts — kept out of version control entirely.
# Code, results and figures are here for reproducibility; the paper itself
# is versioned separately and belongs on a preprint server, not in the repo.
paper/*.docx
paper/*.md
!paper/README.md

# Manuscript-building scripts: they embed the manuscript and response text as strings, so they
# stay local with the manuscript itself (see the note above). The generic quality checks
# (tools/verify_claims.py, check_manuscript.py, docxblocks.py) are published.
tools/add_authors.py
tools/add_equations.py
tools/final_fixes.py
tools/fix_citations.py
tools/make_bmc_version.py
tools/make_faith_version.py
tools/make_response_letter*.py
tools/omml.py
tools/revise_faith_r*.py
tools/update_results_text.py
